# Copy this file to .env and edit the values:
#   cp .env.example .env && chmod 600 .env

# Login for the web page.
# Leave APP_PASSWORD empty only for testing - anyone could switch the relay.
APP_USER=admin
APP_PASSWORD=change-me

# How long a login stays valid, in hours (168 = 7 days)
SESSION_HOURS=168

# EC200U device running relay_server.py
DEVICE_HOST=2401:4900:9864:A48F::2
DEVICE_PORT=5000

# Port this web app listens on
WEB_PORT=8080

# Set to 1 only if this app runs behind Nginx or another reverse proxy
TRUST_PROXY=0
